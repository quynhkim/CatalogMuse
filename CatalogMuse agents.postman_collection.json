    {
      "name": "Files",
      "description": "The engine's own copy of a job image. The UI reads output.url, which is the S3 link. cutout.png is image/png. Scene files such as hero-1-1.jpg are image/jpeg. The name must be a file in that job folder.",
      "item": [
        {
          "name": "Get job file",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/jobs/{{job_id}}/files/{{file_name}}",
              "host": ["{{base_url}}"],
