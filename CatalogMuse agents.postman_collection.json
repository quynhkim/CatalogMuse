        {
          "name": "Get job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const agents = (body && body.agents) || [];",
                  "const segment = agents.find((agent) => agent.name === \"segment\");",
                  "const scene = agents.find((agent) => agent.name === \"scene\");",
                  "const sceneFile = scene && scene.output && scene.output.images && scene.output.images[0] && scene.output.images[0].file;",
                  "const segmentFile = segment && segment.output && segment.output.file;",
                  "const fileName = sceneFile || segmentFile;",
                  "if (fileName) {",
                  "  pm.collectionVariables.set(\"file_name\", fileName);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/jobs/{{job_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "jobs", "{{job_id}}"]
            }
          },
